{
  "name": "@opt2-tealbrick/ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Tealbrick design system: tokens, self-hosted Nunito, React components and the check-system guard (brick 6px / pill, C125/C126/C128).",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./clerk-appearance": {
      "types": "./dist/clerk-appearance.d.ts",
      "default": "./dist/clerk-appearance.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./clerk.css": "./dist/clerk.css",
    "./fonts/*": "./dist/fonts/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "check-system": "./dist/bin/check-system.js"
  },
  "files": [
    "dist",
    "assets",
    "CHANGELOG.md",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "node scripts/build.ts && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node scripts/build.ts && node --test test/*.test.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:system": "node src/bin/check-system.ts src",
    "gallery": "node gallery/build.ts",
    "check:rendered": "node scripts/build.ts && node gallery/build.ts && node scripts/check-rendered.ts"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "happy-dom": "^21.0.4",
    "playwright-core": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
